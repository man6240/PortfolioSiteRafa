# Cloudflare Pages response headers.
# Pages always revalidate, so after an upload no browser keeps an old page that points at
# CSS/JS files from a previous build (that shows up as the site with no styles).
/
  Cache-Control: no-cache
/*.html
  Cache-Control: no-cache
/flag-fiesta/*
  Cache-Control: no-cache
/sugoi-fruit-merge/*
  Cache-Control: no-cache
# Built CSS/JS/images have a content hash in their names, so they can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
